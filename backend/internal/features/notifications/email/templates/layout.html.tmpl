<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:24px;background:#f5f5f5;font-family:Arial,Helvetica,sans-serif;color:#1f2937;">
<div style="max-width:560px;margin:0 auto;background:#ffffff;padding:24px;border-radius:8px;">
<h1 style="font-size:20px;margin:0 0 16px;">{{.Heading}}</h1>
<p style="font-size:15px;line-height:1.5;margin:0 0 24px;">{{.Line}}</p>
<p style="margin:0 0 24px;"><a href="{{.AppURL}}" style="display:inline-block;background:#1d4ed8;color:#ffffff;text-decoration:none;padding:10px 18px;border-radius:6px;font-weight:bold;">{{.Button}}</a></p>
<hr style="border:none;border-top:1px solid #e5e7eb;margin:24px 0 16px;">
<p style="font-size:12px;color:#6b7280;margin:0 0 8px;">{{.FooterLine}}</p>
<p style="font-size:12px;color:#6b7280;margin:0;"><a href="{{.PreferencesURL}}" style="color:#6b7280;">{{.PreferencesLabel}}</a>{{if .UnsubscribeURL}} · <a href="{{.UnsubscribeURL}}" style="color:#6b7280;">{{.UnsubscribeLabel}}</a>{{end}}</p>
</div>
</body>
</html>
