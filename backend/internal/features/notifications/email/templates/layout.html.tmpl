<!doctype html>
<html lang="es-MX" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="x-apple-disable-message-reformatting">
<meta name="format-detection" content="telephone=no,date=no,address=no,email=no">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>{{.Subject}}</title>
{{mso "office"}}
{{template "styles"}}
</head>
<body class="pf-card" style="margin:0;padding:0;background-color:#FFFFFF">
<div style="display:none;max-height:0;max-width:0;overflow:hidden;opacity:0;mso-hide:all;font-size:1px;line-height:1px;color:#FFFFFF">{{.Line}}&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;&#8199;&#847;</div>
<div role="article" aria-roledescription="email" aria-label="{{.Subject}}" lang="es-MX">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" class="pf-card" bgcolor="#FFFFFF" style="width:100%;background-color:#FFFFFF"><tr><td align="center" class="pf-wrap" style="padding:32px 16px 40px">
{{mso "ghostOpen"}}
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="width:100%;max-width:600px">
{{- /* 4 px tone bar */ -}}
<tr><td height="4" class="pf-fill-{{.Tone.Name}}" bgcolor="{{.Tone.Fill}}" style="height:4px;background-color:{{.Tone.Fill}};border-radius:4px;font-size:0;line-height:0">&nbsp;</td></tr>
{{- /* live-text wordmark */ -}}
<tr><td align="center" style="padding:32px 0 0"><a href="{{.HomeURL}}" style="text-decoration:none;display:inline-block" aria-label="PeopleFlow"><span class="pf-wm-p" style="font-family:'Arial Black','Helvetica Neue',Arial,Helvetica,sans-serif;font-weight:900;font-size:24px;line-height:30px;letter-spacing:-0.04em;color:#1A1626">people</span><span class="pf-wm-f" style="font-family:Georgia,'Times New Roman',Times,serif;font-style:italic;font-weight:400;font-size:27px;line-height:30px;letter-spacing:-0.02em;color:#7008E7">flow</span></a></td></tr>
{{- /* 64 px circular seal */ -}}
<tr><td align="center" style="padding:36px 0 0"><table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto"><tr><td width="64" height="64" align="center" valign="middle" class="pf-tint-{{.Tone.Name}} pf-t-{{.Tone.Name}}" bgcolor="{{.Tone.Tint}}" style="width:64px;height:64px;border-radius:50%;background-color:{{.Tone.Tint}};color:{{.Tone.Text}};font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:{{.GlyphSize}}px;line-height:64px;font-weight:700;text-align:center" aria-hidden="true">{{.Glyph}}</td></tr></table></td></tr>
{{- /* eyebrow, urgency, «Obligatorio» */ -}}
{{if or .Eyebrow .Urgency .Mandatory}}<tr><td align="center" style="padding:16px 0 0"><table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" style="margin:0 auto"><tr>
{{- if .Eyebrow}}<td class="pf-t-{{.Tone.Name}}" style="font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:13px;line-height:20px;font-weight:600;color:{{.Tone.Text}};white-space:nowrap">{{.Eyebrow}}</td>{{end}}
{{- if .Urgency}}{{if .Eyebrow}}<td width="8" style="width:8px;font-size:0;line-height:0">&nbsp;</td>{{end}}<td class="pf-fill-{{.Tone.Name}} pf-on-{{.Tone.Name}} pf-bd-{{.Tone.Name}}" bgcolor="{{.Tone.Fill}}" style="padding:3px 9px;border:1px solid {{.Tone.Fill}};border-radius:8px;background-color:{{.Tone.Fill}};color:{{.Tone.OnFill}};font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap">{{.Urgency}}</td>{{end}}
{{- if .Mandatory}}{{if or .Eyebrow .Urgency}}<td width="8" style="width:8px;font-size:0;line-height:0">&nbsp;</td>{{end}}<td class="pf-tint-neutral pf-bd-neutral pf-t-neutral" bgcolor="#F0F0F2" style="padding:3px 9px;border:1px solid #C4C1CC;border-radius:8px;background-color:#F0F0F2;color:#6B6480;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:16px;font-weight:600;white-space:nowrap">{{.MandatoryLabel}}</td>{{end -}}
</tr></table></td></tr>{{end}}
{{- /* 28 px title and body line */ -}}
<tr><td align="center" class="pf-pad" style="padding:12px 48px 0"><h1 class="pf-ink pf-h1c" style="margin:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:28px;line-height:36px;font-weight:700;letter-spacing:-0.01em;color:#1A1626;text-align:center">{{.Heading}}</h1></td></tr>
{{- /* body line, variables in 600 */ -}}
<tr><td align="center" class="pf-pad" style="padding:12px 56px 0"><p class="pf-ink pf-body" style="margin:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:17px;line-height:28px;color:#1A1626;text-align:center">{{.Body}}</p></td></tr>
{{- /* 52 px centered button, VML for Outlook desktop */ -}}
<tr><td align="center" class="pf-pad" style="padding:32px 48px 0"><table role="presentation" cellpadding="0" cellspacing="0" border="0" align="center" class="pf-full" style="border-collapse:separate;margin:0 auto"><tr><td align="center" bgcolor="#7008E7" class="pf-btn" style="border-radius:18px;background-color:#7008E7">
{{.VMLButton}}
{{mso "notMsoOpen"}}<a href="{{.AppURL}}" class="pf-btn pf-btn-t pf-btn-a" style="display:inline-block;padding:16px 28px;border:1px solid #7008E7;border-radius:18px;background-color:#7008E7;color:#F5F3FF;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:16px;line-height:20px;font-weight:600;text-decoration:none;mso-hide:all">{{.Button}}</a>{{mso "notMsoEnd"}}
</td></tr></table></td></tr>
{{- /* rule, footer F1/F2, legal line */ -}}
<tr><td class="pf-pad" style="padding:44px 48px 0"><table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0"><tr><td class="pf-line" style="border-top:1px solid #E4DFF0;font-size:0;line-height:0;height:1px">&nbsp;</td></tr></table></td></tr>
{{- /* footer */ -}}
<tr><td class="pf-pad" style="padding:24px 48px 0"><p class="pf-muted" style="margin:0px 0 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6B6480;text-align:center">{{.FooterLine}}</p><p class="pf-muted" style="margin:6px 0 0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6B6480;text-align:center"><a href="{{.PreferencesURL}}" class="pf-link" style="color:#7008E7;text-decoration:underline">{{.PreferencesLabel}}</a>{{if .UnsubscribeURL}}&nbsp;&nbsp;·&nbsp;&nbsp;<a href="{{.UnsubscribeURL}}" class="pf-link" style="color:#7008E7;text-decoration:underline">{{.UnsubscribeLabel}}</a>{{end}}</p></td></tr>
{{- /* legal line */ -}}
<tr><td class="pf-pad" style="padding:14px 48px 8px"><p class="pf-muted" style="margin:0;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;font-size:12px;line-height:18px;color:#6B6480;text-align:center">{{.Legal}}</p></td></tr></table>
{{mso "ghostClose"}}
</td></tr></table>
</div>
</body>
</html>
{{- define "styles"}}<style>
:root{color-scheme:light dark;supported-color-schemes:light dark}
body{margin:0!important;padding:0!important;width:100%!important;-webkit-text-size-adjust:100%;-ms-text-size-adjust:100%}
table{border-spacing:0;mso-table-lspace:0pt;mso-table-rspace:0pt}
a{text-decoration-thickness:1px;text-underline-offset:2px}
.pf-btn-a:hover{opacity:.9}
@media (max-width:620px){
.pf-wrap{padding:12px 8px 28px!important}
.pf-pad{padding-left:24px!important;padding-right:24px!important}
.pf-padv{padding-top:28px!important;padding-bottom:28px!important}
.pf-side{padding-left:16px!important;padding-right:16px!important}
.pf-h1{font-size:22px!important;line-height:30px!important}
.pf-h1c{font-size:24px!important;line-height:32px!important}
.pf-body{font-size:16px!important;line-height:25px!important}
.pf-full{width:100%!important}
.pf-btn-a{display:block!important;text-align:center!important}
.pf-hide-sm{display:none!important;max-height:0!important;overflow:hidden!important}
}
